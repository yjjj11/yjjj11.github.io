---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import DocNav from '../../components/DocNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const items = (await getCollection('solutions')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return items.map((item) => ({
		params: { slug: item.id },
		props: { item, items },
	}));
}

type Props = {
	item: CollectionEntry<'solutions'>;
	items: CollectionEntry<'solutions'>[];
};

const { item, items } = Astro.props;
const { title, description, category, tags = [], pubDate } = item.data;
const { Content } = await render(item);
const navItems = items.map((i) => ({
	id: i.id,
	title: i.data.title,
	category: i.data.category,
}));
---

<BaseLayout title={`${title} · 问题解决`} description={description}>
	<div class="doc-layout">
		<DocNav
			title="问题目录"
			hrefPrefix="/solutions"
			overviewLabel="总览"
			items={navItems}
			groupByCategory
			activeId={item.id}
		/>

		<section class="doc-main">
			<article class="post-body">
				<div class="title">
					<h1>{title}</h1>
					<div class="meta">
						<span class="badge">{category}</span>
						<span>
							<FormattedDate date={pubDate} />
						</span>
						{tags.map((t) => <span class="tag">#{t}</span>)}
					</div>
				</div>
				<div class="prose markdown">
					<Content />
				</div>
			</article>
		</section>
	</div>
</BaseLayout>
