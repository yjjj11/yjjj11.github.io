---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />
		<Font cssVariable="--font-atkinson" preload />
	</head>
	<body class="splash">
		<!-- 终端风动态背景 -->
		<div class="splash-bg" aria-hidden="true">
			<div class="splash-grid"></div>
			<div class="splash-scanline"></div>
			<div class="splash-glow"></div>
		</div>

		<main class="splash-main">
			<p class="splash-boot">
				<span class="dollar">$</span> ./welcome --site zyjs.blog
			</p>

			<h1 class="splash-title">
				<span class="chev">&gt;_</span>
				<span id="splash-type" class="type"></span>
				<span class="cursor" id="splash-cursor">▊</span>
			</h1>

			<p class="splash-desc" id="splash-desc" aria-hidden="true">
				{SITE_DESCRIPTION}
			</p>

			<p class="splash-hint" id="splash-hint" aria-hidden="true">
				按任意键进入首页 · press any key to enter
			</p>

			<footer class="splash-foot">© {new Date().getFullYear()} {SITE_TITLE}</footer>
		</main>

		<script is:inline>
			// —— 打字机欢迎语 ——
			const typeEl = document.getElementById('splash-type');
			const cursorEl = document.getElementById('splash-cursor');
			const hintEl = document.getElementById('splash-hint');
			const descEl = document.getElementById('splash-desc');
			const text = '欢迎来到 ZYJs Blog';
			let i = 0;
			const type = () => {
				if (i <= text.length) {
					typeEl.textContent = text.slice(0, i);
					i++;
					setTimeout(type, i > text.length ? 0 : 90);
				} else {
					cursorEl.classList.add('steady');
					hintEl.classList.add('show');
					descEl.classList.add('show');
					document.body.classList.add('ready');
				}
			};
			setTimeout(type, 700);

			// —— 任意键 / 点击 / 触摸 → 进入首页 ——
			const enter = () => {
				window.location.href = '/home/';
			};
			document.addEventListener('keydown', enter, { once: true });
			document.addEventListener('click', enter, { once: true });
			document.addEventListener('touchstart', enter, { once: true, passive: true });
		</script>

		<style>
			html,
			body.splash {
				margin: 0;
				min-height: 100vh;
				background: var(--bg);
				color: rgb(var(--gray-dark));
				font-family: var(--sans);
				overflow: hidden;
				cursor: default;
			}

			/* —— 背景层 —— */
			.splash-bg {
				position: fixed;
				inset: 0;
				z-index: 0;
				overflow: hidden;
			}
			.splash-grid {
				position: absolute;
				inset: -2px;
				background-image:
					linear-gradient(rgba(227, 179, 65, 0.055) 1px, transparent 1px),
					linear-gradient(90deg, rgba(227, 179, 65, 0.055) 1px, transparent 1px);
				background-size: 44px 44px;
				mask-image: radial-gradient(ellipse 90% 80% at 50% 45%, #000 40%, transparent 100%);
			}
			.splash-scanline {
				position: absolute;
				left: 0;
				right: 0;
				height: 120px;
				top: -120px;
				background: linear-gradient(
					to bottom,
					transparent,
					rgba(227, 179, 65, 0.06),
					transparent
				);
				animation: scan 9s linear infinite;
			}
			@keyframes scan {
				to {
					transform: translateY(calc(100vh + 240px));
				}
			}
			.splash-glow {
				position: absolute;
				left: 50%;
				top: 46%;
				width: 560px;
				height: 320px;
				transform: translate(-50%, -50%);
				background: radial-gradient(
					ellipse at center,
					rgba(227, 179, 65, 0.09),
					transparent 70%
				);
				filter: blur(20px);
			}

			/* —— 主体 —— */
			.splash-main {
				position: relative;
				z-index: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 2em;
				text-align: center;
			}
			.splash-boot {
				font-family: var(--mono);
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0 0 1.6em;
				animation: fade-up 0.6s ease both;
			}
			.splash-boot .dollar {
				color: var(--accent);
			}
			.splash-title {
				display: flex;
				align-items: baseline;
				justify-content: center;
				gap: 0.5em;
				margin: 0;
				font-family: var(--mono);
				font-size: clamp(1.7rem, 5.5vw, 3.4rem);
				font-weight: 700;
				letter-spacing: 0.01em;
				animation: fade-up 0.6s 0.15s ease both;
			}
			.splash-title .chev {
				color: var(--accent);
			}
			.splash-title .type {
				color: rgb(var(--black));
			}
			.cursor {
				color: var(--accent);
				animation: blink 1s steps(1) infinite;
			}
			.cursor.steady {
				animation: none;
			}
			@keyframes blink {
				50% {
					opacity: 0;
				}
			}
			.splash-desc {
				margin: 1.4em auto 0;
				max-width: 34em;
				font-size: 1.05em;
				color: rgb(var(--gray));
				opacity: 0;
				transform: translateY(6px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			.splash-desc.show {
				opacity: 1;
				transform: none;
			}
			.splash-hint {
				margin-top: 2.4em;
				font-family: var(--mono);
				font-size: 0.9em;
				letter-spacing: 0.05em;
				color: var(--accent);
				opacity: 0;
				transition: opacity 0.8s ease;
			}
			.splash-hint.show {
				opacity: 1;
				animation: pulse 2.2s ease-in-out infinite;
			}
			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.45;
				}
			}
			.splash-foot {
				position: absolute;
				bottom: 1.4em;
				font-family: var(--mono);
				font-size: 0.75em;
				color: rgb(var(--gray));
				opacity: 0.6;
			}
			@keyframes fade-up {
				from {
					opacity: 0;
					transform: translateY(12px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.splash-scanline {
					animation: none;
				}
				.splash-boot,
				.splash-title {
					animation: none;
				}
			}
		</style>
	</body>
</html>
