---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />
		<Font cssVariable="--font-atkinson" preload />
	</head>
	<body class="splash">
		<!-- 终端风动态背景 -->
		<div class="splash-bg" aria-hidden="true">
			<div class="splash-grid"></div>
			<div class="splash-scanline"></div>
			<div class="splash-glow"></div>
		</div>

		<main class="splash-main">
			<div class="splash-decor" aria-hidden="true">
				<svg class="decor-noise" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
					<filter id="grain">
						<feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch" />
						<feColorMatrix type="saturate" values="0" />
					</filter>
					<rect width="100%" height="100%" filter="url(#grain)" />
				</svg>
				<div class="decor-code">
					<span class="dc-line"><b class="dc-p">$</b> astro dev</span>
					<span class="dc-line"><b class="dc-t">▲</b> 02:12:41 ready in <b class="dc-n">318</b>ms</span>
					<span class="dc-line"><b class="dc-c">#</b> ZYJs.Blog · built with dark terminal</span>
					<span class="dc-line"><b class="dc-k">const</b> site = <b class="dc-k">new</b> Blog&#123; theme: <b class="dc-s">'dark'</b> &#125;</span>
					<span class="dc-line">deploy <b class="dc-a">→</b> git push origin main</span>
					<span class="dc-line"><b class="dc-ok">✔</b> 3 posts compiled in <b class="dc-n">412</b>ms</span>
				</div>
			</div>

			<p class="splash-boot">
				<span class="dollar">$</span> ./welcome --site zyjs.blog
			</p>

			<h1 class="splash-title">
				<span class="chev">&gt;_</span>
				<span id="splash-type" class="type"></span>
				<span class="cursor" id="splash-cursor">▊</span>
			</h1>

			<p class="splash-desc" id="splash-desc" aria-hidden="true">
				{SITE_DESCRIPTION}
			</p>

			<p class="splash-hint" id="splash-hint" aria-hidden="true">
				按任意键进入首页 · press any key to enter
			</p>

			<div class="splash-marquee" aria-hidden="true">
				<div class="mq-track">
					<ul class="mq-list">
						<li>Astro</li>
						<li>C++</li>
						<li>分布式</li>
						<li>网络编程</li>
						<li>数据库</li>
						<li>AI Agent</li>
						<li>IO</li>
						<li>GitHub Pages</li>
						<li>Busuanzi</li>
						<li>深色终端</li>
					</ul>
					<ul class="mq-list" aria-hidden="true">
						<li>Astro</li>
						<li>C++</li>
						<li>分布式</li>
						<li>网络编程</li>
						<li>数据库</li>
						<li>AI Agent</li>
						<li>IO</li>
						<li>GitHub Pages</li>
						<li>Busuanzi</li>
						<li>深色终端</li>
					</ul>
				</div>
			</div>

			<footer class="splash-foot">© {new Date().getFullYear()} {SITE_TITLE}</footer>
		</main>

		<script is:inline>
			// —— 打字机欢迎语 ——
			const typeEl = document.getElementById('splash-type');
			const cursorEl = document.getElementById('splash-cursor');
			const hintEl = document.getElementById('splash-hint');
			const descEl = document.getElementById('splash-desc');
			const text = '欢迎来到 ZYJs Blog';
			let i = 0;
			const type = () => {
				if (i <= text.length) {
					typeEl.textContent = text.slice(0, i);
					i++;
					setTimeout(type, i > text.length ? 0 : 90);
				} else {
					cursorEl.classList.add('steady');
					hintEl.classList.add('show');
					descEl.classList.add('show');
					document.body.classList.add('ready');
				}
			};
			setTimeout(type, 700);

			// —— 任意键 / 点击 / 触摸 → 进入首页 ——
			const enter = () => {
				window.location.href = '/home/';
			};
			document.addEventListener('keydown', enter, { once: true });
			document.addEventListener('click', enter, { once: true });
			document.addEventListener('touchstart', enter, { once: true, passive: true });
		</script>

		<style>
			html,
			body.splash {
				margin: 0;
				min-height: 100vh;
				background:
					radial-gradient(80% 60% at 50% 42%, rgba(227, 179, 65, 0.05), transparent 70%),
					var(--bg);
				color: rgb(var(--gray-dark));
				font-family: var(--sans);
				overflow: hidden;
				cursor: default;
			}

			/* —— 背景层 —— */
			.splash-bg {
				position: fixed;
				inset: 0;
				z-index: 0;
				overflow: hidden;
			}
			.splash-grid {
				position: absolute;
				inset: -2px;
				background-image:
					linear-gradient(rgba(227, 179, 65, 0.055) 1px, transparent 1px),
					linear-gradient(90deg, rgba(227, 179, 65, 0.055) 1px, transparent 1px);
				background-size: 44px 44px;
				mask-image: radial-gradient(ellipse 90% 80% at 50% 45%, #000 40%, transparent 100%);
			}
			.splash-scanline {
				position: absolute;
				left: 0;
				right: 0;
				height: 120px;
				top: -120px;
				background: linear-gradient(
					to bottom,
					transparent,
					rgba(227, 179, 65, 0.06),
					transparent
				);
				animation: scan 9s linear infinite;
			}
			@keyframes scan {
				to {
					transform: translateY(calc(100vh + 240px));
				}
			}
			.splash-glow {
				position: absolute;
				left: 50%;
				top: 46%;
				width: 560px;
				height: 320px;
				transform: translate(-50%, -50%);
				background: radial-gradient(
					ellipse at center,
					rgba(227, 179, 65, 0.09),
					transparent 70%
				);
				filter: blur(20px);
			}

			/* —— 中央装饰纹理（噪点 + 代码行） —— */
			.splash-decor {
				position: absolute;
				inset: 0;
				z-index: -1;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				pointer-events: none;
				mask-image: radial-gradient(ellipse 92% 78% at 50% 50%, #000 45%, transparent 92%);
				-webkit-mask-image: radial-gradient(ellipse 92% 78% at 50% 50%, #000 45%, transparent 92%);
			}
			.decor-noise {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0.05;
			}
			.decor-code {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.55em;
				font-family: var(--mono);
				font-size: clamp(0.62rem, 1.35vw, 0.88rem);
				line-height: 1.5;
				color: rgb(var(--gray));
				opacity: 0.5;
				transform: rotate(-1.2deg);
				animation: decor-in 1.6s 0.35s ease both;
			}
			.decor-code b {
				font-weight: 400;
				font-style: normal;
			}
			.decor-code .dc-line {
				white-space: nowrap;
			}
			.dc-line:nth-child(1) {
				padding-left: 0em;
			}
			.dc-line:nth-child(2) {
				padding-left: 1.2em;
			}
			.dc-line:nth-child(3) {
				padding-left: 0.4em;
				opacity: 0.55;
			}
			.dc-line:nth-child(4) {
				padding-left: 0.7em;
			}
			.dc-line:nth-child(5) {
				padding-left: 1.2em;
			}
			.dc-line:nth-child(6) {
				padding-left: 0.4em;
				opacity: 0.75;
			}
			.dc-p {
				color: var(--green);
				opacity: 0.75;
			}
			.dc-t {
				color: var(--accent);
				opacity: 0.6;
			}
			.dc-n {
				color: var(--accent);
				opacity: 0.7;
			}
			.dc-c {
				color: rgb(var(--gray));
				opacity: 0.55;
			}
			.dc-k {
				color: var(--accent);
				opacity: 0.7;
			}
			.dc-s {
				color: var(--green);
				opacity: 0.65;
			}
			.dc-a {
				color: var(--green);
				opacity: 0.7;
			}
			.dc-ok {
				color: var(--green);
				opacity: 0.85;
			}
			@keyframes decor-in {
				from {
					opacity: 0;
					transform: rotate(-1.2deg) translateY(12px);
				}
				to {
					opacity: 0.5;
					transform: rotate(-1.2deg) translateY(0);
				}
			}

			/* —— 主体 —— */
			.splash-main {
				position: relative;
				z-index: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 2em;
				text-align: center;
			}
			.splash-boot {
				font-family: var(--mono);
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0 0 1.6em;
				animation: fade-up 0.6s ease both;
			}
			.splash-boot .dollar {
				color: var(--accent);
			}
			.splash-title {
				display: flex;
				align-items: baseline;
				justify-content: center;
				gap: 0.5em;
				margin: 0;
				font-family: var(--mono);
				font-size: clamp(1.7rem, 5.5vw, 3.4rem);
				font-weight: 700;
				letter-spacing: 0.01em;
				text-shadow: 0 0 40px rgba(227, 179, 65, 0.18);
				animation: fade-up 0.6s 0.15s ease both;
			}
			.splash-title .chev {
				color: var(--accent);
				text-shadow: 0 0 24px rgba(227, 179, 65, 0.5);
			}
			.splash-title .type {
				color: rgb(var(--black));
			}
			.cursor {
				color: var(--accent);
				animation: blink 1s steps(1) infinite;
			}
			.cursor.steady {
				animation: none;
			}
			@keyframes blink {
				50% {
					opacity: 0;
				}
			}
			.splash-desc {
				margin: 1.4em auto 0;
				max-width: 34em;
				font-size: 1.05em;
				color: rgb(var(--gray));
				opacity: 0;
				transform: translateY(6px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			.splash-desc.show {
				opacity: 1;
				transform: none;
			}
			.splash-hint {
				margin-top: 2.6em;
				font-family: var(--mono);
				font-size: 0.85em;
				letter-spacing: 0.05em;
				color: var(--accent);
				border: 1px solid var(--accent-border);
				background: var(--accent-soft);
				border-radius: 999px;
				padding: 0.5em 1.1em;
				opacity: 0;
				transition: opacity 0.8s ease;
			}
			.splash-hint.show {
				opacity: 1;
				animation: pulse 2.2s ease-in-out infinite;
			}
			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.45;
				}
			}
			.splash-foot {
				position: absolute;
				bottom: 1.4em;
				font-family: var(--mono);
				font-size: 0.75em;
				color: rgb(var(--gray));
				opacity: 0.6;
			}

			/* —— 底部滚动标签带 —— */
			.splash-marquee {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 3.4em;
				z-index: 2;
				overflow: hidden;
				padding: 0.8em 0;
				background: rgba(27, 29, 34, 0.55);
				-webkit-backdrop-filter: blur(8px);
				backdrop-filter: blur(8px);
				border-top: 1px solid rgba(227, 179, 65, 0.12);
				border-bottom: 1px solid var(--border-soft);
				mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
				-webkit-mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
			}
			.mq-track {
				display: flex;
				width: max-content;
				animation: mq-scroll 32s linear infinite;
			}
			.splash-marquee:hover .mq-track {
				animation-play-state: paused;
			}
			.mq-list {
				display: flex;
				align-items: center;
				gap: 0.9em;
				padding: 0 0.45em;
				margin: 0;
				list-style: none;
				flex-shrink: 0;
			}
			.mq-list li {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-family: var(--mono);
				font-size: 0.8em;
				letter-spacing: 0.03em;
				white-space: nowrap;
				padding: 0.32em 0.95em;
				border-radius: 999px;
				border: 1px solid;
				opacity: 0.85;
			}
			.mq-list li::before {
				content: "◆";
				font-size: 0.5em;
				transform: translateY(-1px);
			}
			.mq-list li:nth-child(odd) {
				color: var(--accent);
				border-color: rgba(227, 179, 65, 0.3);
				background: rgba(227, 179, 65, 0.07);
			}
			.mq-list li:nth-child(odd)::before {
				color: var(--accent);
				opacity: 0.65;
			}
			.mq-list li:nth-child(even) {
				color: var(--green);
				border-color: rgba(63, 185, 80, 0.28);
				background: rgba(63, 185, 80, 0.06);
			}
			.mq-list li:nth-child(even)::before {
				color: var(--green);
				opacity: 0.65;
			}
			@keyframes mq-scroll {
				to {
					transform: translateX(-50%);
				}
			}
			@keyframes fade-up {
				from {
					opacity: 0;
					transform: translateY(12px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.splash-scanline {
					animation: none;
				}
				.splash-boot,
				.splash-title,
				.decor-code {
					animation: none;
				}
				.splash-marquee .mq-track {
					animation: none;
				}
			}
		</style>
	</body>
</html>
