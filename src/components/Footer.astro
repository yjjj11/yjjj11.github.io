---
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="badges">
		<span class="badge">HTML5</span>
		<span class="badge">CSS3</span>
		<span class="badge">JavaScript</span>
		<span class="badge">Node.js</span>
		<span class="badge">Astro</span>
		<span class="badge">Markdown</span>
	</div>
	<p>
		© {year} · {SITE_TITLE} · 用一杯咖啡和一串代码搭起来的小站
	</p>
	<p class="stack">astro build · markdown · static site</p>
</footer>
<style>
	footer {
		margin-top: 4em;
		padding: 3em 1em 2.5em;
		border-top: 1px solid var(--border);
		background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.25)), var(--bg-panel);
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer p {
		margin: 0;
	}
	footer .stack {
		margin-top: 0.6em;
		font-family: var(--mono);
		font-size: 0.78em;
		opacity: 0.6;
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em;
		margin-bottom: 1.2em;
	}
</style>
