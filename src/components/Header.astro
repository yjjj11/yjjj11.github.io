---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<h2>
			<a href="/home/"><span class="chev">&gt;_</span>{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/home/">首页</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/projects/">项目</HeaderLink>
			<HeaderLink href="/solutions/">问题解决</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(27, 29, 34, 0.78);
		backdrop-filter: blur(14px) saturate(150%);
		-webkit-backdrop-filter: blur(14px) saturate(150%);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1em;
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
	}
	h2 a {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		color: rgb(var(--black));
		text-decoration: none;
		padding: 0.9em 0;
		transition: color var(--duration-fast) ease;
	}
	h2 a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.chev {
		color: var(--accent);
		font-family: var(--mono);
		font-weight: 700;
	}
	.internal-links {
		display: flex;
		gap: 0.4em;
	}
	@media (max-width: 720px) {
		nav {
			padding: 0 0.8em;
		}
		h2 a {
			padding: 0.8em 0;
		}
	}
</style>
