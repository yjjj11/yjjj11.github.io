---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const categories = new Map<string, number>();
const tagSet = new Map<string, number>();
for (const p of posts) {
	if (p.data.category) {
		categories.set(p.data.category, (categories.get(p.data.category) ?? 0) + 1);
	}
	for (const t of p.data.tags ?? []) {
		tagSet.set(t, (tagSet.get(t) ?? 0) + 1);
	}
}

const sorted = [...posts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = sorted.slice(0, 5);

const archives = new Map<string, number>();
for (const p of posts) {
	const key = `${p.data.pubDate.getFullYear()}年${String(
		p.data.pubDate.getMonth() + 1,
	).padStart(2, '0')}月`;
	archives.set(key, (archives.get(key) ?? 0) + 1);
}
const sortedArchives = [...archives.entries()].sort((a, b) =>
	b[0].localeCompare(a[0]),
);
---

<aside class="sidebar">
	<div class="widget">
		<h2>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="14"/></svg>
			站点统计
		</h2>
		<ul class="stats">
			<li><span>文章</span><strong>{posts.length}</strong></li>
			<li><span>分类</span><strong>{categories.size}</strong></li>
			<li><span>标签</span><strong>{tagSet.size}</strong></li>
			<li>
				<span>总浏览</span
				><span class="views" id="busuanzi_site_pv">0</span>
			</li>
		</ul>
	</div>

	<div class="widget">
		<h2>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
			最新文章
		</h2>
		<ul>
			{
				recent.map((p) => (
					<li>
						<a href={`/blog/${p.id}/`}>{p.data.title}</a>
					</li>
				))
			}
		</ul>
	</div>

	{
		categories.size > 0 && (
			<div class="widget">
				<h2>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
					分类
				</h2>
				<ul>
					{[...categories.entries()].map(([name, count]) => (
						<li>
							<a href={`/blog/?cat=${encodeURIComponent(name)}`}>
								{name} <span class="views">({count})</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		tagSet.size > 0 && (
			<div class="widget">
				<h2>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2H2v10l9.3 9.3a1 1 0 0 0 1.4 0l8.6-8.6a1 1 0 0 0 0-1.4z"/><circle cx="7" cy="7" r="1.5"/></svg>
					标签云
				</h2>
				<div class="tags">
					{[...tagSet.entries()].map(([name, count]) => (
						<a
							class="tag"
							href={`/blog/?tag=${encodeURIComponent(name)}`}
						>
							{name}·{count}
						</a>
					))}
				</div>
			</div>
		)
	}

	{
		sortedArchives.length > 0 && (
			<div class="widget">
				<h2>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
					归档
				</h2>
				<ul>
					{sortedArchives.map(([name, count]) => (
						<li>
							<span>{name}</span> <span class="views">({count})</span>
						</li>
					))}
				</ul>
			</div>
		)
	}
</aside>
