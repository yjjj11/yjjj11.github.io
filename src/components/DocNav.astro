---
interface NavItem {
	id: string;
	title: string;
	category?: string;
	badge?: string;
}

interface Props {
	title: string;
	items: NavItem[];
	activeId?: string;
	hrefPrefix: string;
	overviewLabel?: string;
	groupByCategory?: boolean;
}

const {
	title,
	items,
	activeId = '',
	hrefPrefix,
	overviewLabel,
	groupByCategory = false,
} = Astro.props;

// 按分类分组（无分类的归到「其他」）
const groups = new Map<string, NavItem[]>();
for (const item of items) {
	const cat = item.category || '其他';
	if (!groups.has(cat)) groups.set(cat, []);
	groups.get(cat)!.push(item);
}
const groupEntries = [...groups.entries()];

// 难度徽章的颜色映射（简单→绿 / 中等→黄 / 困难→红）
const badgeClass = (badge: string) =>
	badge === '简单' ? 'diff-easy' : badge === '困难' ? 'diff-hard' : 'diff-mid';
---

<aside class="doc-nav">
	<h2 class="doc-nav-title">{title}</h2>
	{
		overviewLabel && (
			<a
				class:list={['doc-nav-link', { active: !activeId }]}
				href={`${hrefPrefix}/`}
			>
				{overviewLabel}
			</a>
		)
	}
	{
		groupByCategory ? (
			groupEntries.map(([category, list]) => (
				<div class="doc-nav-group">
					<h3>{category}</h3>
					<ul>
						{
							list.map((item) => (
								<li>
									<a
										class:list={[
											'doc-nav-link',
											{ active: activeId === item.id },
										]}
										href={`${hrefPrefix}/${item.id}/`}
									>
										<span>{item.title}</span>
									{item.badge && <span class:list={['mini-badge', badgeClass(item.badge)]}>{item.badge}</span>}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			))
		) : (
			<ul>
				{
					items.map((item) => (
						<li>
							<a
								class:list={[
									'doc-nav-link',
									{ active: activeId === item.id },
								]}
								href={`${hrefPrefix}/${item.id}/`}
							>
								<span>{item.title}</span>
									{item.badge && <span class:list={['mini-badge', badgeClass(item.badge)]}>{item.badge}</span>}
							</a>
						</li>
					))
				}
			</ul>
		)
	}
</aside>
