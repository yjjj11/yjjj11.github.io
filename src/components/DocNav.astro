---
interface NavItem {
	id: string;
	title: string;
	category?: string;
	badge?: number;
}

interface Props {
	title: string;
	items: NavItem[];
	activeId?: string;
	hrefPrefix: string;
	overviewLabel?: string;
	groupByCategory?: boolean;
}

const {
	title,
	items,
	activeId = '',
	hrefPrefix,
	overviewLabel,
	groupByCategory = false,
} = Astro.props;

// 按分类分组（无分类的归到「其他」）
const groups = new Map<string, NavItem[]>();
for (const item of items) {
	const cat = item.category || '其他';
	if (!groups.has(cat)) groups.set(cat, []);
	groups.get(cat)!.push(item);
}
const groupEntries = [...groups.entries()];

// 难度星级（1~5，越高越难），颜色映射：1-2星→绿 / 3星→黄 / 4-5星→红
const badgeClass = (n: number) =>
	n >= 4 ? 'diff-hard' : n === 3 ? 'diff-mid' : 'diff-easy';
---

<aside class="doc-nav">
	<h2 class="doc-nav-title">{title}</h2>
	{
		overviewLabel && (
			<a
				class:list={['doc-nav-link', { active: !activeId }]}
				href={`${hrefPrefix}/`}
			>
				{overviewLabel}
			</a>
		)
	}
	{
		groupByCategory ? (
			groupEntries.map(([category, list]) => (
				<div class="doc-nav-group">
					<h3>{category}</h3>
					<ul>
						{
							list.map((item) => (
								<li>
									<a
										class:list={[
											'doc-nav-link',
											{ active: activeId === item.id },
										]}
										href={`${hrefPrefix}/${item.id}/`}
									>
										<span>{item.title}</span>
									{item.badge && (
										<span class:list={['mini-badge', badgeClass(item.badge)]} title={`难度 ${item.badge}/5`}>
											{Array.from({ length: 5 }, (_, i) => (
												<span class:list={[i < item.badge ? 'star-on' : 'star-off']}>{i < item.badge ? '★' : '☆'}</span>
											))}
										</span>
									)}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			))
		) : (
			<ul>
				{
					items.map((item) => (
						<li>
							<a
								class:list={[
									'doc-nav-link',
									{ active: activeId === item.id },
								]}
								href={`${hrefPrefix}/${item.id}/`}
							>
								<span>{item.title}</span>
									{item.badge && (
										<span class:list={['mini-badge', badgeClass(item.badge)]} title={`难度 ${item.badge}/5`}>
											{Array.from({ length: 5 }, (_, i) => (
												<span class:list={[i < item.badge ? 'star-on' : 'star-off']}>{i < item.badge ? '★' : '☆'}</span>
											))}
										</span>
									)}
							</a>
						</li>
					))
				}
			</ul>
		)
	}
</aside>
